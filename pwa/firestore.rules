rules_version = '2';
// ══════════════════════════════════════════════════════════════════
// DOUBLEYOU — PASKAMER PRAAT
// Firestore Security Rules — juni 2026 v13
//
// Wijzigingen t.o.v. v12:
//   +    live_sessions (Paskamer Studio — Live/Talks/Shows/Drops/Sessions)
//   +    live_sessions/{id}/chat  (real-time chat berichten)
//   +    live_sessions/{id}/reactions  (emoji reactions)
//   +    live_sessions/{id}/cohost_invites  (co-host workflow, fase 2)
//   +    live_sessions/{id}/viewers  (aanwezigheid tracker)
//   *    users-schema uitgebreid met studio_link + studio_stats (read-only)
//   *    campaign_events.type whitelist behouden
//
// Studio content architectuur:
//   Alle Studio-formats (Live, Talks, Shows, Drops, Sessions) leven in
//   ÉÉN collectie `live_sessions` met een `format` veld dat één van de
//   5 categorieën bevat. Dit voorkomt collectie-proliferatie en houdt
//   client-queries simpel (WHERE format IN [...]).
//
//   Schema per session doc:
//     format: 'live'|'talks'|'shows'|'drops'|'sessions'  (VERPLICHT)
//     hostUid: string                                      (VERPLICHT)
//     hostType: 'user'|'brand'                             (voor profielkoppeling)
//     hostName: string
//     hostAvatar: string|null
//     brandId: string|null                                 (indien hostType='brand')
//     title: string                                        (1-120 chars)
//     tags: string[]                                       (audience tags: tall, plus, etc.)
//     status: 'live'|'ended'|'scheduled'
//     startedAt: Timestamp
//     endedAt: Timestamp|null
//     scheduledFor: Timestamp|null                         (voor 'scheduled')
//     viewers: number                                      (atomic counter)
//     reactions: number                                    (atomic counter)
//     cohosts: array<{uid, name, joinedAt}>
//
// ══════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────────────────
    function isIngelogd() {
      return request.auth != null;
    }
    function isEchtIngelogd() {
      return isIngelogd() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isEigenDoc(uid) {
      return isIngelogd() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isIngelogd() && (
        request.auth.uid == 'ahtVa6qvFheIy3yDVpDXCz2INwq1' ||
        exists(/databases/$(database)/documents/admin_access/$(request.auth.uid))
      );
    }
    function alleenPubliekeSocialVelden() {
      let gewijzigd = request.resource.data.diff(resource.data).affectedKeys();
      return gewijzigd.hasOnly([
        'volgers', 'volgend', 'dsp_inbox',
        'dsp_lifetime', 'dsp_seizoen',
        'niveau', 'seizoentier',
        'streak_huidig', 'streak_langste', 'streak_laatste_dag',
        'modStatus', 'modReason', 'modBy', 'modAt',
        'pushSubscribed',
        'verhalen_count',
        'leaderboard_opt_in',
        'laatste_actief',
        'huidige_pagina'
      ]);
    }
    function geenWalletVelden() {
      return !(request.resource.data.diff(resource.data).affectedKeys()
        .hasAny([
          'wallet_balance',
          'b2c_wallet_balance',
          'transactions',
          'premium_status',
          'premium_expires_at',
          'shopify_customer_id',
          'pkg_credits',
          'pkg_credits_history',
          'boost_credits_used'
        ]));
    }
    function isBrandOwner(brandId) {
      return isIngelogd() && request.auth.uid == brandId;
    }
    function isApprovedBrand(brandId) {
      return isIngelogd()
        && request.auth.uid == brandId
        && exists(/databases/$(database)/documents/brands/$(brandId))
        && get(/databases/$(database)/documents/brands/$(brandId)).data.status == 'approved';
    }
    // v13 helper: geldig Studio format?
    function isStudioFormat(f) {
      return f == 'live' || f == 'talks' || f == 'shows' || f == 'drops' || f == 'sessions';
    }
    function isSessionHost(sessionId) {
      return isIngelogd()
        && exists(/databases/$(database)/documents/live_sessions/$(sessionId))
        && get(/databases/$(database)/documents/live_sessions/$(sessionId)).data.hostUid == request.auth.uid;
    }


    // ── REALTIME STATUS ──────────────────────────────────────────
    match /realtime_status/{uid} {
      allow read:   if isAdmin();
      allow create: if isIngelogd() && request.auth.uid == uid;
      allow update: if isIngelogd() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    match /activity_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isIngelogd();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /admin_access/{uid} {
      allow read:   if isAdmin();
      allow write:  if request.auth.uid == 'ahtVa6qvFheIy3yDVpDXCz2INwq1';
    }

    match /admin_log/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin() || isIngelogd();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /admin_logs/{logId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // ── USERS ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if true;
      allow create: if isEigenDoc(userId);
      allow update: if (isEigenDoc(userId) && geenWalletVelden()) ||
        (isIngelogd() && alleenPubliekeSocialVelden() && geenWalletVelden()) ||
        isAdmin();
      allow delete: if false;

      match /ai_style_profile/{doc} {
        allow read:  if isEigenDoc(userId) || isAdmin();
        allow write: if isEigenDoc(userId);
      }

      match /push_subscriptions/{endpointId} {
        allow read:   if isEigenDoc(userId) || isAdmin();
        allow create: if isEigenDoc(userId);
        allow update: if isEigenDoc(userId);
        allow delete: if isEigenDoc(userId) || isAdmin();
      }

      match /saved/{itemId} {
        allow read:   if isEigenDoc(userId);
        allow create: if isEigenDoc(userId);
        allow update: if isEigenDoc(userId);
        allow delete: if isEigenDoc(userId);
      }

      match /blocked/{blockedUid} {
        allow read:   if isEigenDoc(userId);
        allow create: if isEigenDoc(userId);
        allow update: if isEigenDoc(userId);
        allow delete: if isEigenDoc(userId);
      }
    }

    // ── STORIES ──────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isEchtIngelogd() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if (isIngelogd() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'likes', 'reacties', 'reactieCount',
            'verborgen', 'views', 'viewCount'
          ])
      )) || isAdmin();
      allow delete: if (isEchtIngelogd() &&
        resource.data.userId == request.auth.uid) || isAdmin();

      match /comments/{commentId} {
        allow read:   if true;
        allow create: if isEchtIngelogd() &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if (isEchtIngelogd() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/stories/$(storyId)).data.userId == request.auth.uid
        )) || isAdmin();
        allow update: if false;
      }

      match /reacties/{reactieId} {
        allow read:   if true;
        allow create: if isEchtIngelogd();
        allow delete: if isEchtIngelogd() &&
          resource.data.userId == request.auth.uid;
        allow update: if false;
      }
    }

    match /dy_stories/{storyId} {
      allow read: if true;
      allow create: if isEchtIngelogd() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isEchtIngelogd() &&
        resource.data.userId == request.auth.uid;
      allow update: if isIngelogd() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'reactieCount', 'expiresAt'])
      );
    }

    match /dy_story_views/{userId} {
      allow read:  if isEigenDoc(userId);
      allow write: if isEigenDoc(userId);

      match /viewers/{viewerUid} {
        allow read:   if isEigenDoc(userId);
        allow create: if isEchtIngelogd() && request.auth.uid == viewerUid;
        allow update: if isEchtIngelogd() && request.auth.uid == viewerUid;
        allow delete: if isEigenDoc(userId);
      }
    }

    match /lookbook/{lookId} {
      allow read: if true;
      allow create: if isEchtIngelogd() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if (isIngelogd() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'reacties', 'reactieCount', 'verborgen'])
      )) || isAdmin();
      allow delete: if (isEchtIngelogd() &&
        resource.data.userId == request.auth.uid) || isAdmin();

      match /comments/{commentId} {
        allow read:   if true;
        allow create: if isEchtIngelogd() &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if (isEchtIngelogd() && (
          resource.data.userId == request.auth.uid ||
          get(/databases/$(database)/documents/lookbook/$(lookId)).data.userId == request.auth.uid
        )) || isAdmin();
        allow update: if false;
      }
    }

    match /looks/{lookId} {
      allow read: if true;
      allow create: if isEchtIngelogd() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if (isIngelogd() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'verborgen', 'stems'])
      )) || isAdmin();
      allow delete: if (isEchtIngelogd() &&
        resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /posts/{postId} {
      allow read:   if true;
      allow create: if isEchtIngelogd() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if (isEchtIngelogd() && resource.data.userId == request.auth.uid &&
        !(request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['boost_active','boost_until','boost_id','impressies','clicks']))) ||
        isAdmin();
      allow delete: if (isEchtIngelogd() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /feed_posts/{postId} {
      allow read:   if true;
      allow create: if isEchtIngelogd() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if (isEchtIngelogd() && resource.data.userId == request.auth.uid &&
        !(request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['boost_active','boost_until','boost_id','impressies','clicks']))) ||
        isAdmin();
      allow delete: if (isEchtIngelogd() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /post_boosts/{boostId} {
      allow read:   if isAdmin() ||
        (isIngelogd() && resource.data.userId == request.auth.uid);
      allow write:  if false;
    }

    match /wallet_transactions/{txId} {
      allow read:   if isAdmin() ||
        (isIngelogd() && resource.data.uid == request.auth.uid);
      allow write:  if false;
    }

    match /pkg_activations/{activationId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    match /reports/{reportId} {
      allow read:   if isAdmin() ||
        (isIngelogd() && resource.data.reporterUid == request.auth.uid);
      allow create: if isEchtIngelogd() &&
        request.resource.data.reporterUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /gesprekken/{gesprekId} {
      allow read: if (isEchtIngelogd() &&
        request.auth.uid in resource.data.deelnemers) || isAdmin();
      allow create: if isEchtIngelogd() &&
        request.auth.uid in request.resource.data.deelnemers;
      allow update: if isEchtIngelogd() &&
        request.auth.uid in resource.data.deelnemers;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isEchtIngelogd() &&
          request.auth.uid in get(/databases/$(database)/documents/gesprekken/$(gesprekId)).data.deelnemers;
        allow create: if isEchtIngelogd() &&
          request.resource.data.userId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/gesprekken/$(gesprekId)).data.deelnemers;
        allow update: if isEchtIngelogd() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['gelezen', 'fotoLikes']);
        allow delete: if false;
      }
    }

    match /user_bookmarks/{userId} {
      allow read:   if isEigenDoc(userId) || isAdmin();
      allow create: if isEigenDoc(userId);
      allow update: if isEigenDoc(userId);
      allow delete: if isEigenDoc(userId) || isAdmin();
    }

    match /dsp_log/{logId} {
      allow read: if (isIngelogd() &&
        resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isIngelogd();
      allow delete: if isIngelogd() &&
        resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if isEchtIngelogd() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if (isEchtIngelogd() &&
        resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if (isEchtIngelogd() &&
        resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /reacties/{reactieId} {
      allow read:   if true;
      allow create: if isEchtIngelogd() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if (isEchtIngelogd() &&
        resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if false;
    }

    match /comments/{commentId} {
      allow read:   if true;
      allow create: if isEchtIngelogd() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if (isEchtIngelogd() &&
        resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if false;
    }

    match /meldingen/{meldingId} {
      allow read:   if isAdmin() ||
        (isIngelogd() && (
          resource.data.reporterUid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        ));
      allow create: if isIngelogd();
      allow update: if isAdmin() ||
        (isIngelogd() && (
          resource.data.reporterUid == request.auth.uid ||
          resource.data.userId == request.auth.uid
        ));
      allow delete: if isAdmin();
    }

    match /berichten/{gesprekId} {
      allow read: if (isEchtIngelogd() &&
        request.auth.uid in resource.data.deelnemers) || isAdmin();
      allow create: if isEchtIngelogd() &&
        request.auth.uid in request.resource.data.deelnemers;
      allow update: if isEchtIngelogd() &&
        request.auth.uid in resource.data.deelnemers;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isEchtIngelogd() &&
          request.auth.uid in get(/databases/$(database)/documents/berichten/$(gesprekId)).data.deelnemers;
        allow create: if isEchtIngelogd() &&
          request.resource.data.userId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/berichten/$(gesprekId)).data.deelnemers;
        allow update: if isEchtIngelogd() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['gelezen', 'fotoLikes']);
        allow delete: if false;
      }
    }

    match /wishlist/{wishId} {
      allow read: if (isEchtIngelogd() &&
        resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isEchtIngelogd() &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isEchtIngelogd() &&
        resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /kleur_stemmen/{stemId} {
      allow read:   if isAdmin();
      allow create: if isIngelogd();
      allow update: if false;
      allow delete: if false;
    }

    match /challenges/{challengeId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /challenge_stemmen/{stemId} {
      allow read:   if isAdmin() ||
        (isIngelogd() && resource.data.uid == request.auth.uid);
      allow create: if isEchtIngelogd();
      allow update: if false;
      allow delete: if false;
    }

    match /challenge_deelnames/{deelnameId} {
      allow read:   if isAdmin() ||
        (isIngelogd() && resource.data.uid == request.auth.uid);
      allow create: if isEchtIngelogd() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /challenge_winnaars/{winId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /push_subscriptions/{userId} {
      allow read:  if isEigenDoc(userId) || isAdmin();
      allow write: if isEigenDoc(userId);
    }

    match /shopify_sync_log/{logId} {
      allow read: if (isIngelogd() &&
        resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isIngelogd() &&
        request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read:  if isIngelogd() &&
        resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /ontwerpen/{ontwerp} {
      allow read:   if isIngelogd() &&
        resource.data.userId == request.auth.uid;
      allow create: if isIngelogd() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isIngelogd() &&
        resource.data.userId == request.auth.uid;
      allow delete: if isIngelogd() &&
        resource.data.userId == request.auth.uid;
    }

    match /maatadviezen/{adviesId} {
      allow read:   if false;
      allow create: if isIngelogd();
      allow update: if false;
      allow delete: if false;
    }

    match /klant_maten/{userId} {
      allow read:   if isEigenDoc(userId);
      allow create: if isEigenDoc(userId);
      allow update: if isEigenDoc(userId);
      allow delete: if isEigenDoc(userId);
    }

    match /polls/{pollId} {
      allow read:   if true;
      allow create: if false;
      allow update: if isIngelogd() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stemmen', 'totaal']);
      allow delete: if false;
    }

    match /pwa_events/{eventId} {
      allow read:   if isAdmin();
      allow create: if isIngelogd();
      allow update: if false;
      allow delete: if false;
    }

    match /app_config/{doc} {
      allow read:  if isIngelogd();
      allow write: if isAdmin();
    }

    match /vergelijkingen/{docId} {
      allow read:   if isAdmin() ||
        (isIngelogd() && resource.data.userId == request.auth.uid);
      allow create: if isEchtIngelogd() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /gedeelde_analyses/{docId} {
      allow read:   if true;
      allow create: if isEchtIngelogd();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /outfit_feedback/{docId} {
      allow read:   if isAdmin();
      allow create: if isEchtIngelogd();
      allow update: if false;
      allow delete: if false;
    }

    match /mailing_list/{uid} {
      allow read:   if isAdmin() ||
        (isIngelogd() && request.auth.uid == uid);
      allow create: if isEigenDoc(uid) || isAdmin();
      allow update: if isEigenDoc(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /mail_campagnes/{docId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    match /mail/{mailId} {
      allow read:   if isAdmin();
      allow create: if isIngelogd();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /weekly_rankings/{weekId} {
      allow read:  if true;
      allow write: if false;
    }

    match /worker_audit_log/{logId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /kai_events/{docId} {
      allow read:   if isAdmin();
      allow create: if isEchtIngelogd();
      allow update: if false;
      allow delete: if false;
    }


    // ══════════════════════════════════════════════════════════════
    // BRAND PORTAL v1
    // ══════════════════════════════════════════════════════════════

    match /brands/{brandId} {
      allow read: if (resource.data.status == 'approved')
                  || isBrandOwner(brandId)
                  || isAdmin();
      allow create: if isBrandOwner(brandId)
                    && request.resource.data.status == 'pending';
      allow update: if (
                      isBrandOwner(brandId)
                      && !(request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['status','moderatedBy','moderatedAt',
                                     'goedgekeurdAt','afgekeurdReden','suspendReden']))
                    ) || (
                      isAdmin()
                      && request.auth.uid != brandId
                    );
      allow delete: if isAdmin() && request.auth.uid != brandId;
    }

    match /brand_products/{productId} {
      allow read: if (resource.data.status == 'actief')
                  || (isIngelogd() && resource.data.brandId == request.auth.uid)
                  || isAdmin();
      allow create: if isApprovedBrand(request.resource.data.brandId)
                    && request.resource.data.brandId == request.auth.uid;
      allow update: if (
                      isIngelogd()
                      && resource.data.brandId == request.auth.uid
                      && request.resource.data.brandId == request.auth.uid
                    ) || isAdmin();
      allow delete: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if (resource.data.status == 'live')
                  || (isIngelogd() && resource.data.brandId == request.auth.uid)
                  || isAdmin();
      allow create: if isApprovedBrand(request.resource.data.brandId)
                    && request.resource.data.brandId == request.auth.uid
                    && (request.resource.data.status == 'draft'
                        || request.resource.data.status == 'review');
      allow update: if (
                      isIngelogd()
                      && resource.data.brandId == request.auth.uid
                      && request.resource.data.brandId == request.auth.uid
                      && !(request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['moderatedBy','moderatedAt',
                                     'impressies','clicks','spend','omzet']))
                      && (request.resource.data.status == 'draft'
                          || request.resource.data.status == 'review'
                          || request.resource.data.status == 'paused')
                    ) || (
                      isAdmin()
                      && resource.data.brandId != request.auth.uid
                    );
      allow delete: if isAdmin() && resource.data.brandId != request.auth.uid;
    }

    match /campaign_events/{eventId} {
      allow read:   if isAdmin();
      allow create: if request.resource.data.keys().hasAny(['type'])
                    && request.resource.data.type in
                       ['impression','product_click','campaign_click','view','dwell'];
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /brand_admin_log/{logId} {
      allow read:   if isAdmin();
      allow create: if isIngelogd();
      allow update: if false;
      allow delete: if isAdmin();
    }


    // ══════════════════════════════════════════════════════════════
    // EXTENSIONS v1.0.0 — Admin Settings, Payments, Events
    // ══════════════════════════════════════════════════════════════

    match /admin_settings/{settingId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read:   if isAdmin()
                    || (isIngelogd() && resource.data.uid == request.auth.uid);
      allow write:  if false;
    }

    match /events/{eventId} {
      // v13: 'live_start', 'live_join', 'live_leave' toegevoegd voor Studio-analytics
      allow create: if isIngelogd()
                    && request.resource.data.type in
                       ['impression','product_click','campaign_click',
                        'outfit_view','outfit_review','ai_query',
                        'similar_view','purchase','wallet_topup','wallet_spend',
                        'live_start','live_join','live_leave','live_end'];
      allow read:   if isAdmin();
      allow update: if false;
      allow delete: if false;
    }


    // ══════════════════════════════════════════════════════════════
    // v12 AUDIT / METRICS COLLECTIONS
    // ══════════════════════════════════════════════════════════════

    match /onboarding_metrics/{docId} {
      allow read:   if isAdmin();
      allow create: if isIngelogd()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /campaign_audit_logs/{docId} {
      allow read:   if isAdmin();
      allow create: if isIngelogd()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /topup_intent_logs/{docId} {
      allow read:   if isAdmin();
      allow create: if isIngelogd()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }


    // ══════════════════════════════════════════════════════════════
    // PASKAMER STUDIO v1.0.0 (v13) — live_sessions + subcollections
    // ══════════════════════════════════════════════════════════════
    //
    // Één collectie voor alle 5 formats: Live / Talks / Shows / Drops / Sessions
    // gecategoriseerd via `format` veld.
    //
    // Security matrix:
    //   Gast:          ✅ read  (session, chat, reactions)
    //                  ❌ create/update/delete
    //   Ingelogde:     ✅ read + chat/reactions create
    //                  ❌ session create (behalve als host)
    //   Host (creator):✅ create + update own session, delete own chat msgs
    //   Approved brand:✅ create met hostType='brand', brandId==self
    //   Admin:         ✅ modereren + delete
    //
    // Viewer counter (viewers-field) mag door iedereen (ingelogd of niet)
    // atomair ge-increment worden zonder host-toestemming.

    match /live_sessions/{sessionId} {
      // Publiek leesbaar — sessies zijn deelbaar (SEO/social share)
      allow read: if true;

      // CREATE:
      //   • host (user) mag session aanmaken met hostUid==self, geldig format
      //   • approved brand mag ook, met hostType='brand' + brandId==self
      allow create: if isEchtIngelogd()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && isStudioFormat(request.resource.data.format)
        && request.resource.data.status in ['live', 'scheduled']
        && (
          // User host
          (request.resource.data.hostType == 'user')
          ||
          // Brand host: brandId moet approved zijn EN gelijk aan auth uid
          (
            request.resource.data.hostType == 'brand'
            && request.resource.data.brandId == request.auth.uid
            && isApprovedBrand(request.auth.uid)
          )
        );

      // UPDATE:
      //   • Host mag eigen sessie updaten (title, status, endedAt, cohosts, tags, viewers, reactions)
      //     MAAR mag hostUid, format, brandId NIET veranderen (immutable identiteit)
      //   • Iedereen (ook gast) mag ALLEEN 'viewers' of 'reactions' atomair bumpen
      //     (voor open-loop viewer counting; frontend gebruikt increment)
      allow update: if (
        // Host update
        isIngelogd()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.format == resource.data.format
        && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title','status','endedAt','cohosts','tags','viewers','reactions',
                      'scheduledFor','thumbUrl',
                      'startedAt','cancelReason','goLiveGraceUntil','reminderCount',
                      'endedReason','autoCompletedAt','autoCompletedBy'])
        )
      ) || (
        // Anonymous / any-user counter bump (viewers, reactions of reminderCount)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
      ) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      ) || (
        // Reminder-teller mag door elke ingelogde user atomair worden gebumped
        // (frontend gebruikt FieldValue.increment(±1) bij subscribe/unsubscribe)
        isEchtIngelogd()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reminderCount'])
      ) || isAdmin();

      // DELETE: alleen host of admin
      allow delete: if isAdmin()
        || (isEchtIngelogd() && resource.data.hostUid == request.auth.uid);

      // ── SUBCOLLECTIE: chat ─────────────────────────────────────
      match /chat/{msgId} {
        allow read: if true;

        // Ingelogd + eigen uid + geldige tekst
        allow create: if isEchtIngelogd()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 240
          && request.resource.data.userName is string
          && request.resource.data.userName.size() <= 40;

        // Update niet toegestaan (chat is immutable — voorkomt edit-manipulatie)
        allow update: if false;

        // Delete: eigenaar van bericht, host van sessie, of admin
        allow delete: if isAdmin()
          || (isEchtIngelogd() && resource.data.uid == request.auth.uid)
          || isSessionHost(sessionId);
      }

      // ── SUBCOLLECTIE: reactions ────────────────────────────────
      match /reactions/{reactionId} {
        allow read: if true;

        // Ingelogd + eigen uid + geldige emoji (max 8 chars)
        allow create: if isEchtIngelogd()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() > 0
          && request.resource.data.emoji.size() <= 8;

        allow update: if false;
        // Delete: alleen host of admin (bulk-cleanup na sessie)
        allow delete: if isAdmin() || isSessionHost(sessionId);
      }

      // ── SUBCOLLECTIE: cohost_invites (fase 2 co-host workflow) ─
      match /cohost_invites/{inviteUid} {
        // Genodigde en host kunnen zien
        allow read: if isEchtIngelogd()
          && (request.auth.uid == inviteUid || isSessionHost(sessionId));

        // Host mag genodigde toevoegen; inviteUid moet real user zijn
        allow create: if isSessionHost(sessionId)
          && request.resource.data.status == 'pending';

        // Genodigde mag zijn invite accepteren/afwijzen (alleen status veld)
        allow update: if isEchtIngelogd()
          && request.auth.uid == inviteUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
          && request.resource.data.status in ['accepted','declined'];

        // Verwijderen: host of genodigde
        allow delete: if isEchtIngelogd()
          && (request.auth.uid == inviteUid || isSessionHost(sessionId));
      }

      // ── SUBCOLLECTIE: viewers (aanwezigheid — fase 2 hostkant analytics) ─
      match /viewers/{viewerUid} {
        // Host + admin kunnen aanwezigheidslijst zien
        allow read: if isAdmin() || isSessionHost(sessionId);

        // Viewer mag eigen aanwezigheid opgeven
        allow create: if isEchtIngelogd() && request.auth.uid == viewerUid;
        allow update: if isEchtIngelogd() && request.auth.uid == viewerUid;
        allow delete: if isEchtIngelogd() && request.auth.uid == viewerUid;
      }

      // ── SUBCOLLECTIE: reminders (opt-in T-15 push voor scheduled lives) ─
      // User schrijft eigen reminder-doc (documentID == user uid). Wordt gelezen
      // door de cron worker om T-15 pushmeldingen te versturen.
      match /reminders/{uid} {
        // Ingelogde users kunnen lezen (nodig voor "ben ik al aangemeld?" check)
        allow read: if isEchtIngelogd() && request.auth.uid == uid;

        // User mag eigen reminder-doc aanmaken/updaten/deleten
        allow create: if isEchtIngelogd()
          && request.auth.uid == uid
          && request.resource.data.uid == uid;
        allow update: if isEchtIngelogd() && request.auth.uid == uid;
        allow delete: if isEchtIngelogd() && request.auth.uid == uid;
      }
    }
  }
}
