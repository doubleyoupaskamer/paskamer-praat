# ═══════════════════════════════════════════════════════════════
# API PROXY: same-origin proxying naar de emergentagent backend.
# Voorkomt "Failed to fetch" door adblock false-positives op de
# preview.emergentagent.com hostname en elimineert cross-origin
# CORS/CSP-complicaties. Werkt voor GET, POST, PUT, DELETE.
# ═══════════════════════════════════════════════════════════════
/api/*  https://paskamer-stability.preview.emergentagent.com/api/:splat  200

# SPA fallback: alle bekende paden → index.html
/feed                  /index.html    200
/looks                 /index.html    200
/reviews               /index.html    200
/winkel                /index.html    200
/challenges            /index.html    200
/post-van-de-week      /index.html    200
/outfit-vergelijker    /index.html    200
/voorwaarden           /voorwaarden/index.html    200
/voorwaarden/*         /voorwaarden/index.html    200
/privacy               /voorwaarden/index.html    200
/community-regels      /index.html    200
/beta                  /index.html    200
/profiel/*             /index.html    200
/verhaal/*             /index.html    200
/look/*                /index.html    200
/share-target          /index.html?pagina=nieuw  200
